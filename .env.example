# Scholarly Graph environment template. Copy to .env and fill in values.
# NEVER commit .env — it stays local only.

# Generic LLM provider (any LiteLLM model string, e.g. claude-sonnet-4-6, gpt-4o-mini)
LLM_MODEL=claude-sonnet-4-6
LLM_API_KEY=
LLM_BASE_URL=
LLM_MAX_TOKENS=1500

# Legacy alias for the LLM key (also accepted)
ANTHROPIC_API_KEY=

# Full-text supplement
CORE_API_KEY=

# Optional: higher Semantic Scholar rate limits (free tier works without it)
SEMANTIC_SCHOLAR_API_KEY=

# Vector store (external Qdrant service — URL + API key, no local Docker)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=scholarly_graph

# Knowledge graph (Neo4j Aura Cloud — connection URI + credentials, no local install)
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# Local file fallbacks (used when Qdrant/Neo4j are not configured)
VECTOR_PATH=data/vector_chunks.json
GRAPH_PATH=data/graph.json
SNAPSHOT_DIR=data/snapshots

# Application
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
